<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Round 2</title>

  <style>
    body {
      margin: 0;
      height: 100vh;
      background: #0b0b0f;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      color: white;
    }

    #box {
      text-align: center;
      max-width: 90%;
    }

    h1 {
      font-size: 32px;
      margin-bottom: 30px;
    }

    button {
      padding: 12px 30px;
      margin: 10px;
      background: #111;
      color: white;
      border: 1px solid #444;
      font-size: 18px;
      cursor: pointer;
      transition: transform 0.2s;
    }

    button:hover {
      transform: scale(1.05);
    }

    img {
      max-width: 80%;
      margin-top: 30px;
      display: none;
      border-radius: 8px;
    }

    #final-text {
      display: none;
      margin-top: 30px;
      font-size: 22px;
      font-style: italic;
      opacity: 0;
      transition: opacity 1.5s ease;
    }
  </style>
</head>

<body>

<div id="box">
  <div id="question">
    <h1>Do you still love me?</h1>
    <button onclick="answer()">Yes</button>
    <button onclick="answer()">Yes</button>
  </div>

  <img id="result" src="answer.png" alt="Your drawing">

  <div id="final-text">
    I will always love you more than life itself.
  </div>
</div>

<script>
function answer() {
  // Hide question + buttons
  document.getElementById("question").style.display = "none";

  // Show image
  const img = document.getElementById("result");
  img.style.display = "block";

  // Show final text after a short pause
  const text = document.getElementById("final-text");
  setTimeout(() => {
    text.style.display = "block";
    setTimeout(() => {
      text.style.opacity = 1;
    }, 100);
  }, 1200);
}
</script>

</body>
</html>
